{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx turbo build --filter=@protools/web",
  "installCommand": "npm install --legacy-peer-deps",
  "ignoreCommand": "npx turbo-ignore @protools/web",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/contract-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/activation-reminder",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/activation-reminder-2",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/trial-ending",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/post-activation",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/fiscal-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/invoice-overdue",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/blog-post",
      "schedule": "23 8 * * 1"
    },
    {
      "path": "/api/cron/blog-post",
      "schedule": "47 11 * * 5"
    }
  ]
}
