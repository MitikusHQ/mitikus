# =============================================================
# ProTools Hub — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# =============================================================

# PostgreSQL (Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Clerk — https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Clerk rutas (no cambiar)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NODE_ENV="development"


# ── Anthropic — IA de generación de herramientas ─────────────────────────────
# Obtén tu clave en: https://console.anthropic.com → API Keys


# ── Límites de generación IA por día (sin redeploy: solo edita y reinicia) ────
# Generaciones permitidas por usuario al día (default: 10)
MAX_AI_GENERATIONS_PER_USER_DAY=10

# Generaciones permitidas por workspace al día (default: 20)
MAX_AI_GENERATIONS_PER_WORKSPACE_DAY=20

# Techo global del sistema al día — protección de costes beta (default: 50)
MAX_AI_GENERATIONS_GLOBAL_DAY=50

# Coste estimado máximo permitido al día en EUR (default: 2.00)
# Base: claude-sonnet-4-6 → $3/1M tokens entrada, $15/1M tokens salida
MAX_AI_ESTIMATED_COST_DAY_EUR=2

# ── Tamaños máximos de entrada/salida ─────────────────────────────────────────
# Longitud máxima del prompt de usuario en caracteres (default: 2000)
MAX_AI_PROMPT_LENGTH=2000

# Tamaño máximo del schema JSON generado en bytes (default: 50000)
MAX_AI_SCHEMA_BYTES=50000
